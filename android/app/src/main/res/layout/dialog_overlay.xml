<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingVertical="8dp">

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/swOverlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/overlay_enable" />

        <EditText
            android:id="@+id/etName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/overlay_name_hint"
            android:inputType="textPersonName|textCapWords"
            android:maxLines="1" />

        <EditText
            android:id="@+id/etRole"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/overlay_role_hint"
            android:inputType="text|textCapSentences"
            android:maxLines="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/overlay_style"
            android:textColor="@color/cs_secondary"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rgStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/rbStyleClean"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/overlay_style_clean" />

            <RadioButton
                android:id="@+id/rbStyleBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/overlay_style_bar" />

            <RadioButton
                android:id="@+id/rbStylePill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/overlay_style_pill" />

            <RadioButton
                android:id="@+id/rbStyleGradient"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/overlay_style_gradient" />
        </RadioGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/overlay_text_color"
            android:textColor="@color/cs_secondary"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/rowTextColors"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/overlay_accent_color"
            android:textColor="@color/cs_secondary"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/rowAccentColors"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/overlay_position"
            android:textColor="@color/cs_secondary"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rgPosition"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbPosLeft"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="@string/overlay_pos_left" />

            <RadioButton
                android:id="@+id/rbPosCenter"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="@string/overlay_pos_center" />

            <RadioButton
                android:id="@+id/rbPosRight"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="@string/overlay_pos_right" />
        </RadioGroup>
    </LinearLayout>
</ScrollView>
